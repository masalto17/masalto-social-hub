# Analytics stays disabled until the privacy policy and matching provider IDs are validated.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Supabase project values. Keep secrets and service-role keys out of public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MVP: one private administrator only. Set this secret in the deployment; never
# commit its value. Without it (or complete Supabase authentication), /app stays closed.
OWNER_ACCESS_SECRET=

# Exact Entradaweb event URL from Hugo. The app appends the campaign UTM parameters.
NEXT_PUBLIC_SABROSO_TICKET_URL=https://www.entradaweb.com.ar/evento/feb5f365/step/1
